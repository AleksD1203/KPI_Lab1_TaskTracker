[Unit]
Description=Task Tracker Docker Container
After=docker.service
Requires=docker.service

[Service]
TimeoutStartSec=0
Restart=always
ExecStartPre=-/usr/bin/docker stop task-tracker-container
ExecStartPre=-/usr/bin/docker rm task-tracker-container
ExecStart=/usr/bin/docker run --name task-tracker-container -p 5000:5000 task-tracker-image
ExecStop=/usr/bin/docker stop task-tracker-container

[Install]
WantedBy=multi-user.target